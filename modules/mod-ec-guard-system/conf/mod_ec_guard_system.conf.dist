# to track and kill targets who escape normal guards.
#

#
#    ECGuard.BountyHunterEnabled
#        Description: Master switch for the bounty hunter system
#        Default:     1 (Enabled)
#
ECGuard.BountyHunterEnabled = 1

#
#    ECGuard.BountyMinWantedLevel
#        Description: Minimum wanted stars to post a bounty (1-5)
#        Default:     3
#
ECGuard.BountyMinWantedLevel = 3

#
#    ECGuard.HunterMinWantedLevel
#        Description: Minimum wanted stars to spawn bounty hunter NPCs (1-5)
#        Default:     4
#
ECGuard.HunterMinWantedLevel = 4

#
#    ECGuard.HunterSpawnDelayMs
#        Description: Delay before first bounty hunter spawns (milliseconds)
#        Default:     300000 (5 minutes)
#
ECGuard.HunterSpawnDelayMs = 300000

#
#    ECGuard.HunterRespawnDelayMs
#        Description: Delay between subsequent hunter spawns (milliseconds)
#        Default:     180000 (3 minutes)
#
ECGuard.HunterRespawnDelayMs = 180000

#
#    ECGuard.BountyDurationMs
#        Description: How long a bounty stays active (milliseconds)
#        Default:     3600000 (1 hour)
#
ECGuard.BountyDurationMs = 3600000

#
#    ECGuard.HunterDespawnTimeMs
#        Description: How long a hunter chases before giving up (milliseconds)
#        Default:     600000 (10 minutes)
#
ECGuard.HunterDespawnTimeMs = 600000

#
#    ECGuard.MaxHuntersPerTarget
#        Description: Maximum bounty hunters tracking one player
#        Default:     2
#
ECGuard.MaxHuntersPerTarget = 2

#
#    ECGuard.HunterCrossZoneTracking
#        Description: Legacy cross-map hunter re-dispatch. Jurisdiction checks
