ECGuard.BountyHunterEntries = ""

#
#    ECGuard.EliteBountyHunterEntry
#        Description: Creature entry for elite hunter (spawns at 5 stars)
#        Default:     0 (Uses regular hunters)
#
ECGuard.EliteBountyHunterEntry = 0

#
#    ECGuard.HunterStatMultiplierPerStar
#        Description: Additional bounty-hunter stat multiplier applied per wanted star
#        Default:     0.25
#
ECGuard.HunterStatMultiplierPerStar = 0.25

#
#    ECGuard.HunterLocalDefenceAnnounce
#        Description: Announce bounty-hunter deployment through the local defence channel
#        Default:     1 (Enabled)
#
ECGuard.HunterLocalDefenceAnnounce = 1

###############################################################################
# WITNESS SYSTEM
###############################################################################
#
# The Witness System adds a GTA-inspired mechanic where crimes only register
# if a friendly NPC witnesses them. When a witness sees a crime, they yell
# and flee toward the nearest guard. The criminal has a window to silence the
# witness before they report the crime.
#
# Guard attacks/kills always register immediately (the guard is its own witness).
# Only civilian crimes require a witness.
#

#
#    ECGuardSystem.Witness.Enabled
#        Description: Enable the witness system for civilian crimes
#        Default:     1 (Enabled)
#
ECGuardSystem.Witness.Enabled = 1

#
#    ECGuardSystem.Witness.Range
#        Description: Radius (yards) to search for NPC witnesses around a crime
#        Default:     40.0
#
ECGuardSystem.Witness.Range = 40.0

#
#    ECGuardSystem.Witness.AlertDurationMs
#        Description: Time (ms) before a witness confirms the crime
#                     Kill the witness within this window to suppress the report.
#        Default:     5000 (5 seconds)
#
ECGuardSystem.Witness.AlertDurationMs = 5000

#
#    ECGuardSystem.Witness.RequireLineOfSight
#        Description: Witness must have line of sight to the crime
#        Default:     1 (Enabled)
#
ECGuardSystem.Witness.RequireLineOfSight = 1

###############################################################################
# PEON CONSTRUCTION SYSTEM
###############################################################################
#
# WC3-style zone fortification system. Peon workers spawn during UNEASY/
# MOBILIZING phases to gather lumber and construct defensive structures
# (bunkers, watchtowers, barricades). Structures persist and decay gradually
# during AFTERMATH/QUIET phases.
#
# These settings live under the Preparation namespace since construction is
# part of the zone preparation lifecycle (ECZonePreparation.cpp).
#

#
#    ECGuardSystem.Preparation.ConstructionEnabled
#        Description: Enable the peon construction system
#        Default:     1 (Enabled)
#
ECGuardSystem.Preparation.ConstructionEnabled = 1

#
#    ECGuardSystem.Preparation.ConstructionUpdateIntervalMs
#        Description: How often to tick construction progress (milliseconds)
#        Default:     1500
#
ECGuardSystem.Preparation.ConstructionUpdateIntervalMs = 1500

#
#    ECGuardSystem.Preparation.WorkDurationMs
#        Description: Duration of one worker construction action (milliseconds)
#        Default:     4000
#
ECGuardSystem.Preparation.WorkDurationMs = 4000

#
#    ECGuardSystem.Preparation.MaxWorkersPerZone
#        Description: Maximum peon workers spawned per zone
#        Default:     8
#
ECGuardSystem.Preparation.MaxWorkersPerZone = 8

#
#    ECGuardSystem.Preparation.InteractiveObjectsEnabled
#        Description: Enable interactive gameobject spawning (capture points, traps, guardposts)
#        Default:     1 (Enabled)
#
ECGuardSystem.Preparation.InteractiveObjectsEnabled = 1
